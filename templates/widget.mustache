
<div id="aurasupport-widget-container" class="aurasupport-widget-closed">
    <!-- Floating Button -->
    <button id="aurasupport-widget-btn" class="aurasupport-floating-btn" aria-label="Open AuraSupport">
        <i class="fa fa-life-ring"></i>
    </button>

    <!-- Widget Panel -->
    <div id="aurasupport-widget-panel" class="aurasupport-widget-panel">
        <!-- Header -->
        <div class="aurasupport-widget-header bg-primary text-white">
            <div class="aurasupport-widget-header-top">
                <h5 class="m-0 font-weight-bold" id="aurasupport-widget-title" style="font-size: 1.1rem;"><i class="fa fa-life-ring mr-2"></i> AuraSupport</h5>
                <div>
                    <a href="{{wwwroot}}/local/aurasupport/tickets.php" target="_blank" class="text-white mr-3" title="View Full Dashboard" style="opacity: 0.8; transition: 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.8"><i class="fa fa-external-link"></i></a>
                    <button id="aurasupport-widget-close" class="btn btn-sm btn-link text-white p-0" style="opacity: 0.8; transition: 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.8"><i class="fa fa-times fa-lg"></i></button>
                </div>
            </div>
            <div class="aurasupport-widget-header-subtitle">
                Hi there! 👋 Welcome to AuraSupport. How can we help you today?
            </div>
        </div>

        <!-- Main View: List of Tickets -->
        <div id="aurasupport-widget-view-list" class="aurasupport-widget-body">
            <div class="p-2">
                <button id="aurasupport-widget-btn-new" class="btn btn-sm btn-success w-100 mb-3"><i class="fa fa-plus"></i> Create New Ticket</button>
                <h6 class="text-muted">Recent Tickets</h6>
                <div id="aurasupport-widget-tickets-list" class="aurasupport-widget-list">
                    <div class="text-center text-muted py-3"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
                </div>
            </div>
        </div>

        <!-- Chat View: Specific Ticket -->
        <div id="aurasupport-widget-view-chat" class="aurasupport-widget-body d-none">
            <div class="p-2 border-bottom">
                <button id="aurasupport-widget-btn-back" class="btn btn-sm btn-light"><i class="fa fa-arrow-left"></i> Back</button>
                <span id="aurasupport-widget-chat-subject" class="font-weight-bold ml-2">Loading...</span>
            </div>
            <div id="aurasupport-widget-chat-messages" class="aurasupport-widget-chat-messages p-2">
                <!-- Messages go here -->
            </div>
            <div class="p-2 bg-white">
                <!-- Preview container for attachment -->
                <div id="aurasupport-widget-attach-preview" class="d-none mb-2 px-2">
                    <span class="badge badge-secondary" style="font-size: 0.8rem; display: inline-flex; align-items: center; padding: 5px 10px; border-radius: 12px; background-color: #e9ecef; color: #495057;">
                        <i class="fa fa-image mr-2"></i> <span id="aurasupport-widget-attach-filename" style="max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></span>
                        <i id="aurasupport-widget-attach-remove" class="fa fa-times ml-2" style="cursor: pointer; color: #dc3545;"></i>
                    </span>
                </div>
                <div class="aurasupport-chat-input-wrapper">
                    <input type="hidden" id="aurasupport-widget-chat-id" value="">
                    
                    <button id="aurasupport-widget-btn-attach" class="aurasupport-chat-attach-btn" type="button" title="Attach Image">
                        <i class="fa fa-paperclip"></i>
                    </button>
                    <input type="file" id="aurasupport-widget-attach-input" accept=".png,.jpg,.jpeg" class="d-none">
                    
                    <input type="text" id="aurasupport-widget-chat-input" class="aurasupport-chat-input" placeholder="Type a reply...">
                    <button id="aurasupport-widget-btn-send" class="aurasupport-chat-send-btn">
                        <i class="fa fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Create View: New Ticket -->
        <div id="aurasupport-widget-view-create" class="aurasupport-widget-body d-none">
            <div class="p-2 border-bottom">
                <button id="aurasupport-widget-btn-back-create" class="btn btn-sm btn-light"><i class="fa fa-arrow-left"></i> Back</button>
                <span class="font-weight-bold ml-2">Create Ticket</span>
            </div>
            <div class="p-3" style="overflow-y:auto; flex:1;">
                <div class="form-group mb-2">
                    <label class="mb-0"><small>Subject</small></label>
                    <input type="text" id="aurasupport-widget-new-subject" class="form-control form-control-sm" required>
                </div>
                <div class="form-group mb-2">
                    <label class="mb-0"><small>Department</small></label>
                    <select id="aurasupport-widget-new-dept" class="form-control form-control-sm" required>
                        <option value="">Select a department...</option>
                        {{#departments}}
                            <option value="{{id}}">{{name}}</option>
                        {{/departments}}
                    </select>
                </div>
                <div class="form-group mb-2">
                    <label class="mb-0"><small>Priority</small></label>
                    <select id="aurasupport-widget-new-priority" class="form-control form-control-sm" required>
                        {{#priorities}}
                            <option value="{{id}}" {{#is_normal}}selected{{/is_normal}}>{{name}}</option>
                        {{/priorities}}
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label class="mb-0"><small>Description</small></label>
                    <textarea id="aurasupport-widget-new-desc" class="form-control form-control-sm" rows="3" required></textarea>
                </div>
                <button id="aurasupport-widget-btn-submit" class="btn btn-sm btn-primary w-100">Submit Ticket</button>
            </div>
        </div>
        
        <!-- Widget Footer -->
        {{#footer_text}}
        <div class="aurasupport-widget-footer text-center p-1 pb-2" style="background-color: #f8f9fc; border-top: 1px solid var(--aura-border); font-size: 0.65rem; color: #858796;">
            <div>{{{footer_text}}}</div>
            <div style="margin-top: 2px;">
                <a href="https://samastanuswantara.com" target="_blank" style="color: #b7b9cc; text-decoration: none; font-size: 0.55rem; opacity: 0.5; transition: 0.3s;" onmouseover="this.style.opacity=1; this.style.color='#4e73df';" onmouseout="this.style.opacity=0.5; this.style.color='#b7b9cc';" title="Developed by Tateta">
                    <i class="fa fa-bolt"></i> power by tateta
                </a>
            </div>
        </div>
        {{/footer_text}}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var config = {
        wwwroot: "{{wwwroot}}",
        sesskey: "{{sesskey}}"
    };
    
    var container = document.getElementById('aurasupport-widget-container');
    var btnOpen = document.getElementById('aurasupport-widget-btn');
    var panel = document.getElementById('aurasupport-widget-panel');
    var btnClose = document.getElementById('aurasupport-widget-close');
    
    var viewList = document.getElementById('aurasupport-widget-view-list');
    var viewChat = document.getElementById('aurasupport-widget-view-chat');
    var viewCreate = document.getElementById('aurasupport-widget-view-create');
    
    var ticketsList = document.getElementById('aurasupport-widget-tickets-list');
    var chatMessages = document.getElementById('aurasupport-widget-chat-messages');
    
    var btnOpenIcon = btnOpen.querySelector('i');
    
    // Toggle Widget
    btnOpen.addEventListener('click', function() {
        if (container.classList.contains('aurasupport-widget-open')) {
            // Close it
            container.classList.add('aurasupport-widget-closed');
            container.classList.remove('aurasupport-widget-open');
            btnOpenIcon.className = 'fa fa-life-ring';
        } else {
            // Open it
            container.classList.remove('aurasupport-widget-closed');
            container.classList.add('aurasupport-widget-open');
            btnOpenIcon.className = 'fa fa-times';
            showList();
        }
    });
    
    btnClose.addEventListener('click', function() {
        container.classList.add('aurasupport-widget-closed');
        container.classList.remove('aurasupport-widget-open');
        btnOpenIcon.className = 'fa fa-life-ring';
    });
    
    // Navigation
    document.getElementById('aurasupport-widget-btn-new').addEventListener('click', function() {
        viewList.classList.add('d-none');
        viewCreate.classList.remove('d-none');
    });
    
    document.getElementById('aurasupport-widget-btn-back').addEventListener('click', function() {
        viewChat.classList.add('d-none');
        viewList.classList.remove('d-none');
    });
    
    document.getElementById('aurasupport-widget-btn-back-create').addEventListener('click', function() {
        viewCreate.classList.add('d-none');
        viewList.classList.remove('d-none');
    });
    
    // API Calls
    function apiCall(action, data, callback) {
        var formData;
        if (data instanceof FormData) {
            formData = data;
        } else {
            formData = new FormData();
            for (var key in data) {
                formData.append(key, data[key]);
            }
        }
        formData.append('sesskey', config.sesskey);
        formData.append('action', action);
        
        fetch(config.wwwroot + '/local/aurasupport/ajax.php', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(result => callback(result))
        .catch(error => console.error('Error:', error));
    }
    
    function showList() {
        viewCreate.classList.add('d-none');
        viewChat.classList.add('d-none');
        viewList.classList.remove('d-none');
        
        ticketsList.innerHTML = '<div class="text-center text-muted py-3"><i class="fa fa-spinner fa-spin"></i> Loading...</div>';
        
        apiCall('widget_get_tickets', {}, function(res) {
            if (res.error) {
                ticketsList.innerHTML = '<div class="text-danger p-2">' + res.error + '</div>';
                return;
            }
            if (res.length === 0) {
                ticketsList.innerHTML = '<div class="text-muted p-2 text-center">No active tickets.</div>';
                return;
            }
            
            var html = '';
            res.forEach(function(t) {
                var badge = t.status == 0 ? 'badge-danger' : (t.status == 1 ? 'badge-warning' : 'badge-success');
                var statusText = t.status == 0 ? 'Open' : (t.status == 1 ? 'Pending' : 'Resolved');
                html += '<div class="aurasupport-widget-ticket-item p-2 border-bottom" data-id="'+t.id+'" data-subject="'+t.subject+'" style="cursor:pointer;">';
                html += '<div class="d-flex justify-content-between">';
                html += '<strong>' + t.subject + '</strong>';
                html += '<span class="badge ' + badge + '">' + statusText + '</span>';
                html += '</div>';
                html += '<small class="text-muted">' + t.timeago + '</small>';
                html += '</div>';
            });
            ticketsList.innerHTML = html;
            
            // Bind clicks
            var items = ticketsList.querySelectorAll('.aurasupport-widget-ticket-item');
            items.forEach(function(item) {
                item.addEventListener('click', function() {
                    openChat(this.getAttribute('data-id'), this.getAttribute('data-subject'));
                });
            });
        });
    }
    
    function openChat(ticketId, subject) {
        viewList.classList.add('d-none');
        viewChat.classList.remove('d-none');
        document.getElementById('aurasupport-widget-chat-subject').textContent = subject;
        document.getElementById('aurasupport-widget-chat-id').value = ticketId;
        
        chatMessages.innerHTML = '<div class="text-center text-muted py-3"><i class="fa fa-spinner fa-spin"></i> Loading...</div>';
        
        loadChat(ticketId);
    }

    function loadChat(id) {
        apiCall('widget_get_chat', { ticketid: id }, function(res) {
            var messages = res.messages || [];
            var status = res.status;
            
            var html = '';
            messages.forEach(function(m) {
                var cls = m.is_mine ? 'my-message' : 'other-message';
                html += '<div class="d-flex '+(m.is_mine?'justify-content-end':'')+' mb-2">';
                html += '<div class="'+cls+' p-2 rounded" style="background:'+(m.is_mine?'#0d6efd':'#e9ecef')+'; color:'+(m.is_mine?'white':'black')+'; max-width:80%;">';
                html += '<div>'+m.message+'</div>';
                html += '<small style="opacity:0.7; font-size:10px;">'+m.sender+' • '+m.timeago+'</small>';
                html += '</div></div>';
            });
            chatMessages.innerHTML = html;
            chatMessages.scrollTop = chatMessages.scrollHeight;
            
            // Hide input if resolved
            var inputWrapper = document.querySelector('.aurasupport-chat-input-wrapper');
            var closedNotice = document.getElementById('aurasupport-widget-closed-notice');
            
            if (status == 2 || status == 3) {
                inputWrapper.style.display = 'none';
                if (!closedNotice) {
                    var notice = document.createElement('div');
                    notice.id = 'aurasupport-widget-closed-notice';
                    notice.className = 'text-center text-muted p-2';
                    notice.innerHTML = '<small><i class="fa fa-lock"></i> Ticket is resolved/closed. Chat is closed.</small>';
                    inputWrapper.parentNode.appendChild(notice);
                } else {
                    closedNotice.style.display = 'block';
                }
            } else {
                inputWrapper.style.display = 'flex';
                if (closedNotice) closedNotice.style.display = 'none';
            }
        });
    }
    
    // Attachments logic
    var btnAttach = document.getElementById('aurasupport-widget-btn-attach');
    var inputAttach = document.getElementById('aurasupport-widget-attach-input');
    var previewAttach = document.getElementById('aurasupport-widget-attach-preview');
    var filenameAttach = document.getElementById('aurasupport-widget-attach-filename');
    var removeAttach = document.getElementById('aurasupport-widget-attach-remove');
    
    btnAttach.addEventListener('click', function() {
        inputAttach.click();
    });
    
    inputAttach.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
            var file = this.files[0];
            filenameAttach.textContent = file.name;
            previewAttach.classList.remove('d-none');
        }
    });
    
    removeAttach.addEventListener('click', function() {
        inputAttach.value = '';
        previewAttach.classList.add('d-none');
    });

    // Send Reply
    document.getElementById('aurasupport-widget-btn-send').addEventListener('click', function() {
        var input = document.getElementById('aurasupport-widget-chat-input');
        var msg = input.value.trim();
        var id = document.getElementById('aurasupport-widget-chat-id').value;
        var file = inputAttach.files.length > 0 ? inputAttach.files[0] : null;
        
        if (!msg && !file) return; // Allow sending just a file
        
        var btn = this;
        var icon = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';
        
        // Use FormData for file upload
        var formData = new FormData();
        formData.append('ticketid', id);
        formData.append('message', msg);
        if (file) {
            formData.append('attachment', file);
        }
        
        apiCall('widget_send_reply', formData, function(res) {
            btn.disabled = false;
            btn.innerHTML = icon;
            if (res.success) {
                input.value = '';
                inputAttach.value = '';
                previewAttach.classList.add('d-none');
                openChat(id, document.getElementById('aurasupport-widget-chat-subject').textContent);
            } else {
                alert(res.error || 'Failed to send message');
            }
        });
    });
    
    // Create Ticket
    document.getElementById('aurasupport-widget-btn-submit').addEventListener('click', function() {
        var subject = document.getElementById('aurasupport-widget-new-subject').value.trim();
        var dept = document.getElementById('aurasupport-widget-new-dept').value;
        var priority = document.getElementById('aurasupport-widget-new-priority').value;
        var desc = document.getElementById('aurasupport-widget-new-desc').value.trim();
        
        if (!subject || !desc || !dept) {
            alert('Please fill in all required fields (Subject, Department, and Description).');
            return;
        }
        
        var btn = this;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Submitting...';
        
        apiCall('widget_create_ticket', { subject: subject, department: dept, priority: priority, description: desc }, function(res) {
            btn.disabled = false;
            btn.innerHTML = 'Submit Ticket';
            if (res.success) {
                document.getElementById('aurasupport-widget-new-subject').value = '';
                document.getElementById('aurasupport-widget-new-desc').value = '';
                showList();
            } else {
                alert(res.error || 'Failed to create ticket');
            }
        });
    });
});
</script>
